# ============================================================================
# BACKEND (Django)
# ============================================================================
# Formato: postgresql://user:password@host:port/database
# Obtenha em: Supabase Dashboard → Settings → Database → Connection String
DATABASE_URL=postgresql://postgres:SEU_PASSWORD@SEU_HOST:5432/postgres

DJANGO_DEBUG=True
DJANGO_SECRET_KEY=sua-chave-secreta-aqui-mudar-em-producao

# URLs permitidas para acessar a API
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================================================
# CORS (Cross-Origin Resource Sharing)
# ============================================================================
# URLs do frontend que podem acessar a API
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ============================================================================
# FRONTEND (Vite / React)
# ============================================================================
# URL da API backend
VITE_API_URL=http://localhost:8000/api

# Obtenha em: Supabase Dashboard → Settings → API
# Project URL
VITE_SUPABASE_URL=https://seu-projeto.supabase.co

# Anon public key (seguro expor no frontend)
VITE_SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
